{
  "name": "lunar-navigator-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-skin.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "skin": "node scripts/build-sprout-skin.mjs",
    "skin:publish": "sh scripts/publish-skin.sh",
    "deploy:preview": "node scripts/check-skin.mjs && vercel pull --yes --environment=preview && vercel build && vercel deploy --prebuilt",
    "deploy": "node scripts/check-skin.mjs && npm test && vercel pull --yes --environment=production && vercel build --prod && vercel deploy --prebuilt --prod",
    "models": "node scripts/build-nasa-models.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "^0.187.0",
    "draco3dgltf": "1.5.9",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vercel": "^65.16.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
